{
	"name": "@kael/backend",
	"version": "0.1.0",
	"description": "AWS CDK infrastructure and Lambda handlers for Kael serverless backend",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "cdk watch",
		"build": "tsc && cdk synth",
		"test": "vitest run --passWithNoTests",
		"test:coverage": "vitest run --coverage --passWithNoTests",
		"type-check": "tsc --noEmit",
		"cdk:deploy": "cdk deploy",
		"cdk:diff": "cdk diff",
		"cdk:synth": "cdk synth"
	},
	"dependencies": {
		"@kael/shared": "workspace:*",
		"@aws-sdk/client-dynamodb": "3.966.0",
		"@aws-sdk/lib-dynamodb": "3.966.0",
		"source-map-support": "0.5.21"
	},
	"devDependencies": {
		"@types/aws-lambda": "8.10.159",
		"@types/node": "25.0.3",
		"aws-cdk": "2.1100.1",
		"aws-cdk-lib": "2.233.0",
		"constructs": "10.4.4",
		"tsx": "4.21.0",
		"vitest": "4.0.16"
	}
}
