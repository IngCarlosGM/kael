root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ts,tsx,js,jsx,mts,cts,mjs,cjs,json}]
indent_style = tab

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[{package.json,pnpm-lock.yaml}]
indent_style = space
indent_size = 2

[*.sh]
indent_style = tab

[*.{bat,cmd}]
end_of_line = crlf
